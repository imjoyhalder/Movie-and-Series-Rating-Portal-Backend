# ─────────────────────────────────────────────────────────────────────────────
# Local development — copy to .env and fill in real values.
# For Vercel production — add every variable below to:
#   Vercel Dashboard → Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=5000

# Database (Neon, Supabase, Railway, etc.)
DATABASE_URL="postgresql://user:password@localhost:5432/movie_portal_db"

# Better Auth
# Production: set BETTER_AUTH_URL to your deployed backend URL
#   e.g. https://your-backend.vercel.app
# BETTER_AUTH_URL is auto-detected from VERCEL_URL if not set explicitly.
BETTER_AUTH_SECRET=your_better_auth_secret_here_min_32_chars
BETTER_AUTH_URL=http://localhost:5000

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Stripe
# Get keys from https://dashboard.stripe.com/apikeys
# Get price IDs from https://dashboard.stripe.com/products
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_MONTHLY_PRICE_ID=price_your_monthly_price_id
STRIPE_YEARLY_PRICE_ID=price_your_yearly_price_id

# ─────────────────────────────────────────────────────────────────────────────
# Email (Gmail App Password)
#
# SETUP STEPS:
#  1. Go to https://myaccount.google.com/security
#  2. Enable 2-Step Verification
#  3. Go to https://myaccount.google.com/apppasswords
#  4. Create an app password for "Mail" → copy the 16-char code
#  5. Paste the 16-char code as SMTP_PASS (no spaces needed)
#
# IMPORTANT — Gmail requires the FROM address to match SMTP_USER exactly.
# Do NOT use a custom domain in EMAIL_FROM unless you own that domain's SMTP.
#
# For Vercel production you MUST add SMTP_USER, SMTP_PASS, and EMAIL_FROM
# to Vercel Environment Variables — the .env file is ignored in production.
# ─────────────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your16charapppassword
EMAIL_FROM="your_email@gmail.com"

# Frontend URL — used in email links and CORS allowed origins
# Production: set to your deployed frontend URL
#   e.g. https://your-frontend.vercel.app
FRONTEND_URL=http://localhost:3000

# Cloudinary (optional — used for poster image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
